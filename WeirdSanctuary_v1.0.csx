importGroup.QueuePrepend(Step("obj_ch4_DCA02"), @"
if (global.flag[2450] == 1 && variable_instance_exists(id, ""mcon"") && mcon >= 0)
{
    if (mcon == 0)
    {
        mcon = 1;
        customcon = 0;
        global.interact = 1;
        global.facing = 0;
        global.mod_choice = -1;
        scr_setparty(0, 0, 0);
        cutscene_master = scr_cutscene_make();
        scr_maincharacters_actors();
        c_sel(kr);
        c_autowalk(0);
        c_sprite(spr_kris_fell);
        c_setxy(162, 120);
        c_wait(5);
        c_var_lerp_instance(blackall, ""image_alpha"", 1, 0, 30);
        c_wait(90);
        c_soundplay(snd_noise);
        c_sel(kr);
        c_sprite(spr_krisb_defeat);
        c_shakeobj();
        c_wait(60);
        c_sel(kr);
        c_sprite(spr_kris_dw_landed);
        c_imageindex(0);
        c_wait(20);
        c_autowalk(1);
        c_facing(""d"");
        c_wait(20);
        c_walkdirect_speed_wait(210, 200, 2);
        c_wait(8);
        c_autowalk(0);
        c_soundplay(snd_noise);
        c_sprite(spr_kris_injured);
        c_imagespeed(0);
        c_imageindex(3);
        c_shakeobj();
        c_wait(12);
        c_var_instance(id, ""mod_count"", 1);
        c_wait(10);
        c_waitcustom();
    }
    if (mcon == 1 && customcon == 1)
    {
        mcon = 2;
        customcon = 0;
    }
    if (mod_count == 1 && mcon <= 2)
    {
        if (mod_basex == 0)
        {
            mod_basex = kr_actor.x;
        }
        if (!d_ex() && (left_p() || right_p() || up_p() || down_p() || keyboard_check_pressed(vk_left) || keyboard_check_pressed(vk_right) || keyboard_check_pressed(vk_up) || keyboard_check_pressed(vk_down)))
        {
            mod_presses++;
            mod_shake = 8;
            snd_stop(snd_hurt1);
            snd_play_x(snd_hurt1, 0.4, 1.2);
        }
        if (mod_shake > 0)
        {
            mod_shake--;
            kr_actor.x = mod_basex + (((mod_shake % 2) == 0) ? 2 : -2);
            if (mod_shake == 0)
            {
                kr_actor.x = mod_basex;
            }
        }
        if (mcon == 2 && mod_presses >= 15)
        {
            mod_count = 2;
            mod_shake = 0;
            kr_actor.x = mod_basex;
            mcon = 3;
            c_waitcustom_end();
            c_wait(30);
            c_speaker(""ralsei"");
            c_customfunc(function()
            {
                global.fc = 0;
                global.fe = 0;
            });
            if (is_english())
            {
                c_msgset(0, ""* ..^1. where..^1. could they be...?/%"");
            }
            else
            {
                c_msgset(0, ""＊ …どこ…だろう…？/%"");
            }
            c_talk_wait();
            c_wait(15);
            c_speaker(""ralsei"");
            if (is_english())
            {
                c_msgset(0, ""\\EC* ..^1. K-Kris!?/%"");
            }
            else
            {
                c_msgset(0, ""\\EC＊ …クリス！？/%"");
            }
            c_talk_wait();
            c_wait(10);
            c_customfunc(function()
            {
                with (obj_ch4_DCA02)
                {
                    ra = 1;
                    ra_actor = instance_create(660, 232, obj_actor);
                    scr_actor_setup(ra, ra_actor, ""ralsei"");
                    ra_actor.sprite_index = spr_ralseil;
                    with (ra_actor)
                    {
                        scr_depth();
                    }
                }
            });
            c_wait(2);
            c_sel(1);
            c_autowalk(0);
            c_addxy(0, -6);
            c_sprite(spr_ralsei_run_left);
            c_imagespeed(0.4);
            c_walkdirect_speed_wait(kr_actor.x + 72, 226, 10);
            c_sprite(spr_ralsei_run_up);
            c_walkdirect_speed_wait(kr_actor.x + 72, kr_actor.y - 18, 8);
            c_imagespeed(0);
            c_addxy(0, 6);
            c_autowalk(1);
            c_facing(""l"");
            c_wait(1);
            c_customfunc(function()
            {
                with (obj_ch4_DCA02)
                {
                    var _d = kr_actor.bbox_bottom - ra_actor.bbox_bottom;
                    if (_d != 0)
                    {
                        with (ra_actor)
                        {
                            scr_lerpvar(""y"", y, y + _d, 6);
                        }
                    }
                }
            });
            c_wait(6);
            c_speaker(""ralsei"");
            if (is_english())
            {
                c_msgset(0, ""\\EC* Oh..^1. oh no...!/%"");
            }
            else
            {
                c_msgset(0, ""\\EC＊ わあ…！\n　 た…大変…！/%"");
            }
            c_talk_wait();
            c_sel(1);
            c_autowalk(0);
            c_sprite(spr_ralsei_spell_left);
            c_addxy(-65, -8);
            c_imageindex(0);
            c_imagespeed(0.2);
            c_wait(20);
            c_var_instance(id, ""mod_heal"", true);
            c_wait(25);
            c_addxy(65, 8);
            c_autowalk(1);
            c_facing(""l"");
            c_wait(20);
            c_speaker(""ralsei"");
            if (is_english())
            {
                c_msgset(0, ""\\EQ* Kris^1, are you okay?/%"");
            }
            else
            {
                c_msgset(0, ""\\EQ＊ クリス^1　だいじょうぶ？/%"");
            }
            c_talk_wait();
            c_sel(kr);
            c_sprite(spr_kris_dw_landed);
            c_imageindex(0);
            c_wait(15);
            c_autowalk(1);
            c_facing(""r"");
            c_wait(1);
            c_customfunc(function()
            {
                with (obj_ch4_DCA02)
                {
                    var _d = kr_actor.bbox_bottom - ra_actor.bbox_bottom;
                    if (_d != 0)
                    {
                        with (ra_actor)
                        {
                            scr_lerpvar(""y"", y, y + _d, 6);
                        }
                    }
                }
            });
            c_wait(19);
            c_msc(9712);
            c_talk_wait();
            c_waitcustom();
        }
    }
    if (mcon == 3 && customcon == 1 && !d_ex() && global.mod_choice >= 0)
    {
        mcon = 4;
        customcon = 0;
        c_waitcustom_end();
        c_wait(10);
        c_speaker(""ralsei"");
        if (global.mod_choice == 0)
        {
            if (is_english())
            {
                c_msgset(0, ""\\EQ* Sorry I'm late^1, Kris./"");
                c_msgnext(""\\EQ* Here^1, hold still^1, let me wipe your tears./"");
                c_msgnext(""\\EZ* ..^1. Huh? Susie fell into the dark.../"");
                c_msgnext(""\\EZ* ..^1. and she's badly hurt!?/"");
            }
            else
            {
                c_msgset(0, ""\\EQ＊ 遅れて　ごめんね\n　 クリス。/"");
                c_msgnext(""\\EQ＊ ほら^1　涙　ふくから\n　 じっとしてて。/"");
                c_msgnext(""\\EZ＊ …え？　スージィが\n　 暗闇に　落ちて…/"");
                c_msgnext(""\\EZ＊ 大けがも　してる！？/"");
            }
        }
        else
        {
            if (is_english())
            {
                c_msgset(0, ""\\EZ* Huh!? Susie was pushed by a Darkner.../"");
                c_msgnext(""\\EZ* ..^1. and she's badly hurt!?/"");
            }
            else
            {
                c_msgset(0, ""\\EZ＊ え？　スージィが\n　 ダークナーに\n　 突き落とされて…/"");
                c_msgnext(""\\EZ＊ 大けがしてる！？/"");
            }
        }
        if (is_english())
        {
            c_msgnext(""\\EC* Oh no! I'll go help her^1, so.../"");
            c_msgnext(""\\EC* Kris^1, please wait here!/%"");
        }
        else
        {
            c_msgnext(""\\EC＊ 大変！　助けに行くから\n　 クリスは　ここで\n　 待ってて！/%"");
        }
        c_talk_wait();
        c_sel(1);
        c_autowalk(0);
        c_addxy(0, -6);
        c_sprite(spr_ralsei_run_down);
        c_imagespeed(0.4);
        c_walkdirect_speed_wait(kr_actor.x + 72, 226, 8);
        c_sprite(spr_ralsei_run_right);
        c_walkdirect_speed_wait(700, 226, 10);
        c_visible(0);
        c_wait(30);
        c_sel(kr);
        c_facing(""d"");
        c_wait(1);
        c_customfunc(function()
        {
            global.facing = 0;
            with (obj_mainchara)
            {
                sprite_index = dsprite;
                image_index = 0;
            }
        });
        c_actortokris();
        c_terminatekillactors();
    }
    if (mcon == 4 && !i_ex(obj_cutscene_master))
    {
        mcon = 99;
        scr_setparty(0, 0, 0);
        global.plot = 120;
        global.facing = 0;
        global.interact = 0;
    }
    if (mod_heal)
    {
        mod_heal = false;
        snd_play(snd_spellcast);
        var _healamt = instance_create(kr_actor.x, kr_actor.y, obj_dmgwriter);
        with (_healamt)
        {
            delay = 4;
            type = 3;
            specialmessage = 3;
        }
        _healamt.damage = global.maxhp[global.char[0]];
        var _healanim = instance_create(kr_actor.x, kr_actor.y, obj_healanim);
        _healanim.target = kr_actor.id;
        global.hp[global.char[0]] = global.maxhp[global.char[0]];
    }
    exit;
}
");

