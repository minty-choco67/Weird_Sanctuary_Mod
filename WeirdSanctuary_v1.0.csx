UndertaleCode Ev(string obj, EventType t) => Data.GameObjects.ByName(obj).EventHandlerFor(t, Data);
UndertaleCode Step(string obj) => Data.GameObjects.ByName(obj).EventHandlerFor(EventType.Step, EventSubtypeStep.Step, Data);

importGroup.QueuePrepend(Ev("obj_ch4_PDC01A", EventType.Create), @"
if (global.plot < 5)
{
    global.flag[2450] = 1;
    global.flag[2451] = 1;
    global.flag[2452] = 0;
    global.flag[2453] = 0;
    for (var _m = 0; _m < 10; _m++)
    {
        scr_itemget(2);
    }
    if (global.charweapon[1] != 26)
    {
        var _oldw = global.charweapon[1];
        global.charweapon[1] = 26;
        if (_oldw != 0)
        {
            scr_weaponget(_oldw);
        }
    }
    if (global.chararmor1[1] != 23 && global.chararmor2[1] != 23)
    {
        var _olda = global.chararmor1[1];
        global.chararmor1[1] = 23;
        if (_olda != 0)
        {
            scr_armorget(_olda);
        }
    }
    scr_weaponget(24);
    scr_weaponinfo_mine();
    scr_armorinfo_mine();
    scr_weaponinfo_all();
    scr_armorinfo_all();
    snd_free_all();
    global.darkzone = 0;
    scr_become_light();
    global.plot = 100;
    global.flag[794] = 0;
    scr_losechar();
    scr_getchar(2);
    with (obj_border_controller)
    {
        set_border(border_lw_town, 1);
        show_border(1);
    }
    room_goto(room_town_church);
    instance_destroy();
    exit;
}
");

