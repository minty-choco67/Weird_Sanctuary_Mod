                    depth = _kd + 20;
                    scr_lerpvar(""image_xscale"", 1, 40, 14, 2, ""out"");
                    scr_lerpvar(""x"", _kx - 2, 240, 14, 2, ""out"");
                    scr_lerpvar(""image_yscale"", 10, (_bot - _top) / 4, 18, 2, ""out"");
                    scr_lerpvar(""y"", _row * 40, _top, 18, 2, ""out"");
                }
                for (var _i = 0; _i < 26; _i++)
                {
                    var _d = scr_dark_marker(244 + random(150), _top + random(_bot - _top), spr_pixel_white);
                    with (_d)
                    {
                        image_blend = make_color_rgb(40, 70, 170);
                        image_xscale = 1.5 + random(2.5);
                        image_yscale = 1 + random(1.5);
                        image_angle = random(360);
                        depth = _kd + 10;
                        vspeed = -2 - random(3);
                        hspeed = random_range(-1.5, 1.5);
                        gravity = 0.5;
                        scr_delay_var(""visible"", 1, irandom(10));
                        visible = 0;
                        scr_doom(id, 50);
                    }
                }
            }
            snd_play(snd_break2);
            snd_play(snd_screenshake);
        });
        c_shake();
        c_sel(kr);
        c_facing(""d"");
