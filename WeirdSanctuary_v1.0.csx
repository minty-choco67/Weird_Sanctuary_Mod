        }
        global.flag[9] = 1;
    }
    if (mcon == 2 && global.fighting == 1)
    {
        mcon = 3;
    }
    if (mcon == 3 && global.fighting == 0 && !i_ex(obj_endbattle))
    {
        mcon = 4;
        with (obj_marker)
        {
            if (variable_instance_exists(id, ""modbat""))
            {
                instance_destroy();
            }
        }
        global.modfreezebt = 0;
        global.modgerturn = 0;
        mgemmake();
        with (obj_npc_gerson)
        {
            instance_destroy();
        }
        with (obj_darkener)
        {
            instance_destroy();
        }
        with (obj_gerson_darken)
        {
            instance_destroy();
        }
        global.plot = 152;
        global.flag[2461] = 1;
        scr_setparty(0, 0, 0);
        global.interact = 1;
        global.facing = 1;
        obj_mainchara.cutscene = 1;
        mod_block_north();
        cutscene_master = scr_cutscene_make();
        c_pan_wait(clamp(obj_mainchara.x - 301, 0, room_width - 640), clamp(obj_mainchara.y - 202, 0, room_height - 480), 20);
        c_customfunc(function()
        {
            obj_mainchara.cutscene = 0;
        });
        c_terminatekillactors();
    }
    if (mcon == 4 && !i_ex(obj_cutscene_master))
