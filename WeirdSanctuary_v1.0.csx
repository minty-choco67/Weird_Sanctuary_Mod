                }
                with (kr_actor)
                {
                    scr_lerpvar(""image_index"", 0, 16, 70, 3, ""out"");
                    scr_lerpvar(""y"", y, y - 100, 90, 3, ""out"");
                }
            }
        });
        c_wait(30);
        c_customfunc(function()
        {
            obj_ch4_DCA01.fallsequence.con = 4;
