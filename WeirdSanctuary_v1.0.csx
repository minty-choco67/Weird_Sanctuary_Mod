// Weird Sanctuary v1.0  -  DELTARUNE Chapter 4 改変Mod
// 使い方: UndertaleModTool で「未改造の」Chapter 4 の data.win を開く → Scripts > Run other script... でこのファイルを選ぶ
//         →「Weird Sanctuary v1.0 を適用しました」と出たら File > Save で保存
// ※ 一度適用した data.win に もう一度適用しないでください（元に戻すには Steam の「ファイルの整合性を確認」）
// ※ 付属の dark_sanctuary_weird.ogg は ゲームの Chapter 4 の mus フォルダに入れてください

EnsureDataLoaded();

if (Data.Rooms.ByName("room_dw_church_intropiano") == null || Data.GameObjects.ByName("obj_ch4_DCA02") == null)
{
    ScriptError("Chapter 4 の data.win ではないようです。");
    return;
}
void ModAddSprite(string _name, string _b64, int _w, int _h, int _ox, int _oy, int _frames = 1)
{
    if (Data.Sprites.ByName(_name) != null)
    {
        return;
    }
    byte[] _png = Convert.FromBase64String(_b64);
    var _tex = new UndertaleEmbeddedTexture();
    _tex.Name = new UndertaleString("Texture " + Data.EmbeddedTextures.Count);
    var _td = _tex.TextureData;
    var _imgProp = _td.GetType().GetProperty("Image");
    var _blobProp = _td.GetType().GetProperty("TextureBlob");
    if (_imgProp != null)
    {
        System.Reflection.MethodInfo _fromPng = null;
        foreach (var _m in _imgProp.PropertyType.GetMethods())
        {
            var _ps = _m.GetParameters();
            if (_m.Name == "FromPng" && _m.IsStatic && _ps.Length >= 1 && _ps[0].ParameterType == typeof(byte[]))
            {
                _fromPng = _m;
                break;
            }
        }
        var _args = new object[_fromPng.GetParameters().Length];
        _args[0] = _png;
        for (int _i = 1; _i < _args.Length; _i++)
        {
            _args[_i] = _fromPng.GetParameters()[_i].HasDefaultValue ? _fromPng.GetParameters()[_i].DefaultValue : null;
        }
        _imgProp.SetValue(_td, _fromPng.Invoke(null, _args));
    }
    else if (_blobProp != null)
    {
        _blobProp.SetValue(_td, _png);
    }
    else
    {
        throw new Exception("この UndertaleModTool では画像を追加できませんでした。0.8 以降の UndertaleModTool で適用してください。");
    }
    Data.EmbeddedTextures.Add(_tex);
    var _tpis = new System.Collections.Generic.List<UndertaleTexturePageItem>();
    for (int _f = 0; _f < _frames; _f++)
    {
        var _tpi = new UndertaleTexturePageItem();
        _tpi.Name = new UndertaleString("PageItem " + Data.TexturePageItems.Count);
        _tpi.SourceX = (ushort)(_f * _w); _tpi.SourceY = 0; _tpi.SourceWidth = (ushort)_w; _tpi.SourceHeight = (ushort)_h;
        _tpi.TargetX = 0; _tpi.TargetY = 0; _tpi.TargetWidth = (ushort)_w; _tpi.TargetHeight = (ushort)_h;
        _tpi.BoundingWidth = (ushort)_w; _tpi.BoundingHeight = (ushort)_h; _tpi.TexturePage = _tex;
        Data.TexturePageItems.Add(_tpi);
        _tpis.Add(_tpi);
    }
    var _ref = Data.Sprites.ByName("spr_attack_cut1");
    var _spr = new UndertaleSprite();
    _spr.Name = Data.Strings.MakeString(_name);
    _spr.Width = (uint)_w; _spr.Height = (uint)_h;
    _spr.MarginLeft = 0; _spr.MarginRight = _w - 1; _spr.MarginTop = 0; _spr.MarginBottom = _h - 1;
    _spr.OriginX = _ox; _spr.OriginY = _oy;
    _spr.IsSpecialType = _ref.IsSpecialType; _spr.SVersion = _ref.SVersion; _spr.SepMasks = _ref.SepMasks;
    _spr.BBoxMode = _ref.BBoxMode; _spr.GMS2PlaybackSpeed = _ref.GMS2PlaybackSpeed; _spr.GMS2PlaybackSpeedType = _ref.GMS2PlaybackSpeedType;
    _spr.SSpriteType = _ref.SSpriteType;
    foreach (var _t in _tpis)
    {
        _spr.Textures.Add(new UndertaleSprite.TextureEntry { Texture = _t });
    }
    Data.Sprites.Add(_spr);
}
