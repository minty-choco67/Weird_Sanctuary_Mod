        c_facing(""l"");
        c_sel(kr);
        c_facing(""r"");
        c_wait(10);
        c_speaker(""susie"");
        if (is_english())
        {
            c_msgset(0, ""\\E2* ...What's with that face?^1 I'm totally fine^1, okay?/"");
            c_msgnext(""\\ED* I was peeking into the dark^1, and outta nowhere^1, some Darkner just went BAM./"");
            c_msgnext(""\\E5* Ugh..^1. That jerk.^1 Next time I see 'em^1, I'm kicking their butt./"");
