importGroup.QueuePrepend(Step("obj_dw_gerson_study"), @"
if (variable_instance_exists(id, ""mgem""))
{
    if (mgemcon == 0 && i_ex(mgem) && i_ex(obj_mainchara) && global.interact == 0 && button1_p() && point_distance(obj_mainchara.x + 19, obj_mainchara.y + 60, mgem.x + (mgem.sprite_width / 2), mgem.y + (mgem.sprite_height / 2)) < 40)
