    {
        snd_free(mknm0);
        mknm0 = -4;
    }
    exit;
}
");

importGroup.QueuePrepend(Step("obj_dw_church_ripseq1"), @"
if (global.flag[2450] == 1 && global.flag[2453] == 1 && con < 4 && variable_instance_exists(id, ""init"") && init == 1)
{
    if (scr_trigcheck(""seqEnd""))
    {
        audio_sound_gain(global.currentsong[1], 0, 120000 / fps);
        con = 4;
        global.interact = 1;
    }
}
if (global.flag[2450] == 1 && global.flag[2453] == 1 && con == 4)
{
    con = 5;
    cutscene_master = scr_cutscene_make();
    c_msgruncheck(true);
    c_speaker(""noelle"");
    if (is_english())
    {
        c_msgset(0, ""\\EV* It should have run this way.../%"");
    }
    else
    {
        c_msgset(0, ""\\EV＊ こっちに　逃げたはず…/%"");
    }
    c_talk_wait();
    c_var_instance(id, ""makerip"", 1);
    c_wait(40);
    c_msgruncheck(false);
    c_speaker(""noelle"");
    if (is_english())
    {
        c_msgset(0, ""\\EG* ...!!/"");
        c_msgnext(""\\Em* I'll lure it somewhere bright^1, then take it down!/%"");
    }
    else
    {
        c_msgset(0, ""\\EG＊ …ッ！！/"");
        c_msgnext(""\\Em＊ 明るい場所に\n　 誘導してから　倒そう！/%"");
    }
    c_talk_wait();
    c_var_instance(id, ""makerip"", 2);
    c_wait(15);
    c_var_instance(id, ""nextroom"", 1);
    c_wait(180);
}
");

