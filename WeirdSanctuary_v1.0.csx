        obj_mainchara.cutscene = 0;
        global.facing = 0;
        with (obj_mainchara)
        {
            sprite_index = dsprite;
            image_index = 0;
        }
        global.interact = 0;
    }
}
");

importGroup.QueueAppend(Ev("obj_hammer_of_justice_enemy", EventType.Create), @"
modbattle = 0;
if (global.flag[2450] == 1 && global.encounterno == 9720)
{
    modbattle = 1;
    init = 1;
    with (obj_battleback)
