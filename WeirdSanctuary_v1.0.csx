    with (obj_marker)
    {
        var _hit = false;
        for (var _k = 0; _k < array_length(_list); _k++)
        {
            if (sprite_index == _list[_k])
            {
                _hit = true;
            }
        }
        if (_hit)
        {
            other.mev_freeze_copy(sprite_index, image_index, x, y, image_xscale, image_yscale, depth);
            instance_destroy();
        }
    }
    if (layer_exists(""GIVE_DEPTH""))
    {
        var _els = layer_get_all_elements(""GIVE_DEPTH"");
        for (var _e = 0; _e < array_length(_els); _e++)
        {
            if (layer_get_element_type(_els[_e]) == layerelementtype_sprite)
            {
                var _el = _els[_e];
                mev_freeze_copy(layer_sprite_get_sprite(_el), layer_sprite_get_index(_el), layer_sprite_get_x(_el), layer_sprite_get_y(_el), layer_sprite_get_xscale(_el), layer_sprite_get_yscale(_el), 0);
                layer_sprite_destroy(_el);
            }
        }
    }
    var _ld = 999950;
    with (obj_dw_gerson_study_lights)
    {
        _ld = depth;
        instance_destroy();
    }
    mev_freeze_copy(spr_dw_gerson_lighting_corner, 0, 0, 0, 1, 1, _ld);
    mev_freeze_copy(spr_dw_gerson_lighting_corner, 0, 960, 0, -1, 1, _ld);
    mev_freeze_copy(spr_dw_gerson_lighting, 0, 34, 130, 1, 1, _ld);
    mev_freeze_copy(spr_dw_gerson_lighting, 0, 34, 402, 1, 1, _ld);
    mev_freeze_copy(spr_dw_gerson_lighting, 0, 896, 130, 1, 1, _ld);
    mev_freeze_copy(spr_dw_gerson_lighting, 0, 896, 402, 1, 1, _ld);
    mev_freeze_copy(spr_gerson_hammer_only, 0, 520, 905, 2, 2, 999980);
    mev_freeze_copy(spr_old_man_statue_shards, 0, 500, 960, 2, 2, 999985);
    var _ix = [250, 380, 690, 760, 300, 640, 470, 560];
    var _iy = [880, 1000, 860, 960, 950, 1010, 1000, 860];
    for (var _i = 0; _i < array_length(_ix); _i++)
    {
        with (scr_dark_marker(_ix[_i], _iy[_i], spr_icespell_hexagon))
        {
            image_xscale = 1;
            image_yscale = 1;
            image_speed = 0;
            image_alpha = 0.7;
            image_angle = _i * 25;
            depth = 998000;
        }
    }
};
if (global.flag[2450] == 1 && global.flag[2459] == 1)
