            {
                mod_land.image_index = 0;
            }
        });
        c_sel(kr);
        c_sprite(spr_kris_dw_landed);
        c_wait(12);
        c_sel(kr);
        c_autowalk(1);
        c_facing(""r"");
        c_wait(10);
        c_sel(no);
        c_autowalk(1);
        c_facing(""l"");
        c_wait(20);
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* About that enemy that ran off.../"");
            c_msgnext(""* That was me./%"");
        }
        else
        {
            c_msgset(0, ""＊ さっきの　逃げた　敵の\n　 ことじゃが/"");
            c_msgnext(""＊ あれは　ワシじゃ/%"");
        }
        c_talk_wait();
        c_customfunc(function()
        {
            with (obj_dw_gerson_study)
            {
                mod_land.image_index = 1;
            }
            snd_play_pitch(motor_swing_down, 1.4);
        });
        c_wait(4);
        c_customfunc(function()
        {
            with (obj_dw_gerson_study)
            {
                with (mod_land)
                {
                    sprite_index = spr_gerson_idle;
                    image_index = 0;
                    image_speed = 1/3;
                    y += 16;
                }
                mod_hair = scr_dark_marker(mod_land.x + 36, mod_land.y + 10, spr_gerson_hair);
                with (mod_hair)
                {
                    image_speed = 0.2;
                    depth = other.mod_land.depth - 1;
                }
            }
        });
        c_wait(15);
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* I'll give the two of ya one chance to change your ways./%"");
        }
        else
        {
            c_msgset(0, ""＊ おまえさんたちに　一度だけ\n　 改心の　機会を　やろう。/%"");
        }
        c_talk_wait();
        c_customfunc(function()
        {
            global.facing = 1;
            with (obj_mainchara)
            {
                sprite_index = rsprite;
                image_index = 0;
            }
        });
        c_actortokris();
        c_actortocaterpillar();
        c_terminatekillactors();
    }
    if (mcon == 1 && !i_ex(obj_cutscene_master))
    {
        mcon = 2;
        global.flag[2462] = 1;
        scr_tempsave();
        global.flag[2459] = 1;
        snd_free_all();
        global.flag[9] = 2;
        global.batmusic[0] = snd_init(""ch4_extra_boss.ogg"");
        global.flag[54] = 2460;
        obj_mainchara.cutscene = 1;
        camerax_set(160);
