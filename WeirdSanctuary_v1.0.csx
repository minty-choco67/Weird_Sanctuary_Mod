                var _ky = kr_actor.y + 66;
                var _kd = kr_actor.depth;
                var _row = floor((kr_actor.y + 75) / 40);
                var _top = (_row - 3) * 40;
                var _bot = (_row + 2) * 40;
                mod_hole = scr_dark_marker(_kx - 2, _row * 40, spr_pixel_white);
                with (mod_hole)
                {
