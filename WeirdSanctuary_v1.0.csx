    mturn = 1;
    mresume11 = 0;
    if (variable_global_exists(""modgerturn"") && global.modgerturn >= 11)
    {
        mturn = 11;
        mresume11 = 1;
    }
    mseqon = 0;
    mseqmode = 0;
    mline = 0;
    mtalktimer = 0;
    mwait = 0;
    mspk = [];
    mtxt = [];
    miceused = 0;
    mdefect = 0;
    mice = 0;
    micet = 0;
    mnspell = -4;
    mkrice = -4;
    mhex = [-4, -4, -4];
    global.modfreezebt = 0;
    mdeftimer = 0;
    mdefmark = -4;
    nslot = -1;
    nenemy = -4;
    mfin = 0;
    mshield = 0;
    mpost = 0;
    global.modshellchain = 0;
    m20 = 0;
    m20t = 0;
    m20n = 0;
    m20sw = 0;
    m20shield = 0;
    m21 = 0;
    m21t = 0;
    m21k = 0;
    m21i = 0;
    m21shield = 0;
    m21x0 = 0;
    m21L = 0;
    m21R = 0;
    m21L0 = 0;
