        scr_spearpattern(choose(""l"", ""r"", ""u"", ""d""), 16, 20, 35, 1, 0);
        scr_spearpattern(0, 0, -9, 32, 10, 0);
        scr_spearpattern(0, 0, 0, 1, 24, 0);
        scr_spearpattern(choose(""l"", ""r"", ""u"", ""d""), 16, 20, 35, 1, 0);
        scr_spearpattern(0, 0, -9, 32, 30, 0);
        scr_spearpattern(3, 0, 0, 28, 1, 0);
        scr_spearpattern(0, 0, 0, 33, 1, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 3, 0);
        scr_spearpattern(0, 0, -3, 4, 27, 0);
        scr_spearpattern(0, 0, 0, 9, 60, 0);
        scr_spearpattern(0, 0, 0, 10, 1, 0);
        return true;
    }
    if (_t == 11)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, -11, 32, 9999, 0);
        return true;
    }
    if (_t == 12)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 36, 1, 0);
        scr_spearpattern(0, 0, -12, 32, 9999, 0);
        return true;
    }
    if (_t == 13)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 36, 1, 0);
        scr_spearpattern(0, 0, -13, 32, 9999, 0);
        return true;
    }
    if (_t == 15)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 36, 1, 0);
        scr_spearpattern(0, 0, -15, 32, 9999, 0);
        return true;
    }
    if (_t == 16 || _t == 17 || _t == 18 || _t == 19)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 1, 0, 0);
        scr_spearpattern(0, 0, 0, 3, 0, 0);
        scr_spearpattern(0, 0, -_t, 32, 9999, 0);
        return true;
    }
    if (_t == 14)
    {
        museVanilla(70);
        return true;
    }
    if (_t >= 1000)
    {
        museVanilla(_t - 1000);
        return true;
    }
    if (_t == 121)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 36, 10, 0);
        scr_spearpattern(0, 0, 0, 3, 4, 0);
        var _d = choose(0, 90, 180, 270);
        var _sg = choose(1, -1);
        for (var _i = 0; _i < 32; _i++)
        {
            var _turnto = (_d + 180) mod 360;
            if (_turnto == 0)
            {
                _turnto = 360;
            }
            scr_spearpattern(_d, 18 + (_i * 0.2), 32, _turnto, (_i == 31) ? 35 : 5, 0);
            _d = (_d + (45 * _sg) + 360) mod 360;
            if (_i == 15)
            {
                _sg = -_sg;
            }
        }
        scr_spearpattern(""l"", 16, 20, 35, 1, 0);
        scr_spearpattern(0, 0, -21, 32, 9999, 0);
        return true;
    }
    if (_t == 120)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        global.modshellchain = 1;
        scr_spearpattern(x, y, 60, 52, 9999);
        return true;
    }
    if (_t == 99)
    {
        scr_spearpattern_reset();
        boxoffset = false;
        scr_spearpattern(0, 0, 0, 10, 1, 0);
        return true;
    }
    return false;
};
");

