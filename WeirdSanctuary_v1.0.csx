            c_msgnext(""\\EM* Ralsei found me right away^1, but you were nowhere to be found./"");
            c_msgnext(""\\EB* ......Eh^1, whatever./"");
            c_msgnext(""\\E0* Looks like the fountain's right up ahead./"");
            c_msgnext(""\\E2* Next time^1, let's go on an adventure together!/"");
            c_msgnext(""\\EY* But this time^1, I'm getting there first./%"");
        }
        else
        {
            c_msgset(0, ""\\E2＊ …んだよ　その顔。\n　 オレなら\n　 ピンピンしてるっての。/"");
            c_msgnext(""\\ED＊ 暗いとこ　のぞいてたら\n　 いきなり　ダークナーに\n　 ドンッだ。/"");
            c_msgnext(""\\E5＊ ったく…　あのヤロー\n　 次　会ったら　ぶっとばす。/"");
            c_msgnext(""\\E1＊ …で　オマエは？\n　 ケガとか\n　 してねーだろうな。/"");
            c_msgnext(""\\EM＊ ラルセイとは\n　 すぐ会えたのに　オマエだけ\n　 全然　見つかんねーし。/"");
            c_msgnext(""\\EB＊ ……まあ　いいや。/"");
            c_msgnext(""\\E0＊ 泉は　すぐそこ\n　 みたいだな。/"");
            c_msgnext(""\\E2＊ 次は　いっしょに\n　 冒険しようぜ！/"");
            c_msgnext(""\\EY＊ だが　こんかいは　オレが\n　 一番乗りだ。/%"");
        }
        c_talk_wait();
        c_sel(su);
        c_autowalk(0);
        c_sprite(spr_susie_run_up);
        c_imagespeed(0.4);
        c_walkdirect(300, 130, 20);
        c_delaycmd4(18, ""var"", id, ""susie_hide"", true);
        c_wait(6);
        c_sel(kr);
        c_facing(""u"");
        c_wait(60);
        c_sel(su);
        c_visible(0);
        c_wait(30);
        c_sel(kr);
        c_facing(""d"");
        c_speaker(""ralsei"");
