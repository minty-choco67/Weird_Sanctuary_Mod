        c_sprite(spr_ralsei_surprised_left);
        c_wait(30);
        c_sel(ra);
        c_sprite(spr_ralsei_turn_away_left);
        c_wait(30);
        c_speaker(""ralsei"");
        if (is_english())
        {
            c_msgset(0, ""\\El* ..^1. Kris. Where's Susie?/%"");
        }
        else
        {
            c_msgset(0, ""\\El＊ …クリス。\n　 スージィは　どこ？/%"");
        }
        c_talk_wait();
        c_sel(ra);
        c_sprite(spr_ralsei_shocked_subtle_left);
        c_wait(60);
        c_facing(""u"");
        c_speaker(""ralsei"");
