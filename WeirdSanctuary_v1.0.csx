        c_autowalk(0);
        c_autodepth(false);
        c_sprite(spr_kris_fall_d_dw);
        c_imagespeed(0.6);
        c_customfunc(function()
        {
            with (obj_ch4_DCA01.kr_actor)
            {
                scr_lerpvar(""y"", y, y + 50, 14, 3, ""in"");
                scr_lerpvar(""image_alpha"", 1, 0, 14);
            }
        });
        c_wait(18);
        c_customfunc(function()
        {
            obj_ch4_DCA01.blackall.image_alpha = 1;
        });
        c_wait(40);
        c_customfunc(function()
        {
            with (obj_ch4_DCA01)
            {
                fallsequence = instance_create(0, cameray(), obj_ch4_DCA01_fall);
                prophecy = instance_create(camerax() + 320, cameray() + 500, obj_dw_church_prophecy);
                prophecy.extflag = ""initial2"";
                prophecy.depth = 60;
                prophecy.destroykind = 2;
                prophecy.hitstop = 10;
                wind_effect.con = 1;
                wind_effect.depth = 10;
                with (wind_effect)
                {
                    scr_lerpvar(""windspeed"", windspeed, 24, 30);
                }
                kr_actor.depth = 70;
                kr_actor.visible = 1;
                kr_actor.image_alpha = 1;
                with (mod_hole)
                {
                    instance_destroy();
                }
                kr_actor.x = (camerax() + 320) - 4;
                kr_actor.y = cameray() - 64;
                kr_actor.image_xscale = -2;
                with (kr_actor)
                {
                    scr_lerpvar(""y"", cameray() - 64, cameray() + 200, 90, 3, ""out"");
                }
                mod_wind_snd = mus_loop_ext(snd_init(""strongwind_loop.ogg""), 0.6, 1.5);
            }
        });
        c_wait(40);
        c_customfunc(function()
        {
            obj_ch4_DCA01.fallsequence.con = 1;
        });
        c_wait(20);
        c_customfunc(function()
        {
            obj_ch4_DCA01.fallsequence.con = 2;
        });
        c_wait(30);
        c_customfunc(function()
        {
