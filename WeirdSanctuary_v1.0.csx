    mprevmnf = 0;
    m13mode = 1;
    mpullt = 0;
    mpullx = 0;
    mpully = 0;
    mswd = -4;
    mknf = -4;
    mpullat = function(_who)
    {
        if (!i_ex(nenemy))
        {
            mdodge(_who);
            return;
        }
        var _tlx = (nenemy.x - 23) - 67;
        var _tly = nenemy.y + 14;
        mdodge(_who);
        mslashslot = nslot;
        x = _tlx + 40;
        y = _tly + 30;
        mpull();
    };
    mkrisset = function(_kind)
    {
        var _k = global.charinstance[0];
        if (!i_ex(_k))
        {
            return;
        }
        var _pre = (_kind == ""sword"") ? ""spr_krisb_"" : (""spr_mod_krisb_"" + _kind + ""_"");
        with (_k)
        {
            idlesprite = asset_get_index(_pre + ""idle"");
            defendsprite = asset_get_index(_pre + ""defend"");
            hurtsprite = asset_get_index(_pre + ""hurt"");
            attackreadysprite = asset_get_index(_pre + ""attackready"");
            attacksprite = asset_get_index(_pre + ""attack"");
            itemsprite = asset_get_index(_pre + ""item"");
            itemreadysprite = asset_get_index(_pre + ""itemready"");
            actreadysprite = asset_get_index(_pre + ""actready"");
            actsprite = asset_get_index(_pre + ""act"");
            spellreadysprite = actreadysprite;
            spellsprite = actsprite;
            defeatsprite = asset_get_index(_pre + ""defeat"");
            victorysprite = asset_get_index(_pre + ""victory"");
            sprite_index = idlesprite;
        }
    };
    mpull = function()
    {
        if (!i_ex(nenemy) || mpullt > 0)
        {
            return;
        }
        mpullt = 1;
        mpullx = nenemy.x;
        mpully = nenemy.y;
    };
    mrun = -4;
    mkr = -4;
    mkn = -4;
    mknm0 = -4;
    mknm1 = -4;
    mkrl = -4;
    mknight = -4;
    mcam0 = 160;
    mcrumble = -4;
    mghair = -4;
    mrunph = 0;
    mfintimer = 0;
    mblack = -4;
    mgmark = -4;

    mangdiff = function(_a, _b)
    {
        var _d = abs(((_a - _b) mod 360 + 360) mod 360);
        return min(_d, 360 - _d);
    };
    mneed = function(_ang)
    {
        if (_ang <= 0)
        {
            return 0;
        }
        if (_ang <= 45)
        {
            return 4;
        }
        if (_ang <= 90)
        {
            return 6;
        }
        return 8;
    };
    mfzgen = function(_base, _k, _cap)
    {
        var _n = array_length(_base);
        var _fz = array_create(_n, 0);
        var _c = 0;
        var _cands = [];
        for (var _ci = 2; _ci < _n; _ci++)
        {
            if (_base[_ci][4] == 0 || _base[_ci][4] == 20)
            {
                array_push(_cands, _ci);
            }
        }
        while (_c < _k && array_length(_cands) > 0)
        {
            var _ri = irandom(array_length(_cands) - 1);
            _fz[_cands[_ri]] = 1;
            array_delete(_cands, _ri, 1);
            _c++;
        }
        var _out = [];
        var _evT = [];
        var _evD = [];
        var _evF = [];
        var _frA = [];
        var _frB = [];
        var _frD = [];
        var _last = -1;
        var _shift = 0;
        var _d8 = [0, 45, 90, 135, 180, 225, 270, 315];
        for (var _i = 0; _i < _n; _i++)
        {
            var _b = _base[_i];
            var _s = _b[2];
            var _f = _b[3];
            var _t = _b[0] + _shift;
            var _placed = false;
            var _g = 0;
            while (!_placed && _g < 200)
            {
                _g++;
                var _fzat = _t + _f - (110 / _s);
                if (_fz[_i] == 1)
                {
                    var _now = 0;
                    for (var _q = 0; _q < array_length(_frA); _q++)
                    {
                        if (_frA[_q] <= _fzat && _fzat < _frB[_q])
                        {
                            _now++;
                        }
                    }
                    if (_now < _cap)
                    {
                        var _off = irandom(7);
                        for (var _j = -1; _j < 8 && !_placed; _j++)
                        {
                            var _d = (_j < 0) ? _b[1] : _d8[(_j + _off) mod 8];
                            if (_d == _last)
                            {
                                continue;
                            }
                            var _bad = false;
                            for (var _q = 0; _q < array_length(_frA); _q++)
                            {
                                if (_frD[_q] == _d && _frA[_q] <= _fzat && _fzat < _frB[_q])
                                {
                                    _bad = true;
                                }
                            }
                            if (_bad)
                            {
                                continue;
                            }
                            var _a = _fzat + 40 + ((110 - 36) / _s);
                            var _fT = [_a];
                            var _fD = [_d];
                            if (_b[4] == 20)
                            {
                                _fT = [_a, _a + 39, _a + 39, _a + 78];
                                _fD = [_d, (_d + 90) mod 360, (_d + 270) mod 360, (_d + 180) mod 360];
                            }
                            var _ok = true;
                            for (var _m3 = 0; _m3 < array_length(_fT) && _ok; _m3++)
                            {
                                for (var _q = 0; _q < array_length(_evT); _q++)
                                {
                                    var _ang = mangdiff(_fD[_m3], _evD[_q]);
                                    if (_ang > 0 && abs(_fT[_m3] - _evT[_q]) < (mneed(_ang) + 6))
                                    {
                                        _ok = false;
                                        break;
                                    }
                                }
                            }
                            if (_ok)
                            {
                                array_push(_out, [round(_t), _d, 40, 15, -1, _b[4], _s, _f]);
                                for (var _m4 = 0; _m4 < array_length(_fT); _m4++)
                                {
                                    array_push(_evT, _fT[_m4]);
                                    array_push(_evD, _fD[_m4]);
                                    array_push(_evF, true);
                                }
                                array_push(_frA, _fzat);
                                array_push(_frB, _fzat + 40);
                                array_push(_frD, _d);
                                _last = _d;
                                _placed = true;
                            }
                        }
                        if (_placed)
                        {
                            break;
                        }
                    }
                }
                var _a2 = _t + _f - (36 / _s);
                var _mT = [_a2];
                var _mD = [_b[1]];
                if (_b[4] == 20)
                {
                    _mT = [_a2, _a2 + 39, _a2 + 39, _a2 + 78];
                    _mD = [_b[1], (_b[1] + 90) mod 360, (_b[1] + 270) mod 360, (_b[1] + 180) mod 360];
                }
                var _ok2 = true;
                for (var _m = 0; _m < array_length(_mT) && _ok2; _m++)
                {
                    for (var _q = 0; _q < array_length(_evT); _q++)
                    {
                        var _ang2 = mangdiff(_mD[_m], _evD[_q]);
                        if (_evF[_q] && _ang2 > 0 && abs(_mT[_m] - _evT[_q]) < (mneed(_ang2) + 6))
                        {
                            _ok2 = false;
                            break;
                        }
                    }
                }
                if (_ok2)
                {
                    array_push(_out, [round(_t), _b[1], 0, 0, -1, _b[4], _s, _f]);
                    for (var _m2 = 0; _m2 < array_length(_mT); _m2++)
                    {
                        array_push(_evT, _mT[_m2]);
                        array_push(_evD, _mD[_m2]);
                        array_push(_evF, false);
                    }
                    _placed = true;
                    break;
                }
                _t += 2;
                _shift += 2;
            }
        }
        return _out;
    };
    matkfor = function(_n, _sh)
    {
        if (_n < 15)
        {
            return _n;
        }
        if (_sh == 1)
        {
            return (_n == 20) ? 120 : 121;
        }
        if (_n >= 15 && _n <= 19)
        {
            return _n;
        }
        if (_n <= 21)
        {
            var _vt = [0, 53, 55, 56, 220, 220, 19];
            return 1000 + _vt[_n - 15];
        }
        var _vl = [55, 56, 220, 220, 19];
        return 1000 + _vl[(_n - 22) % 5];
    };
    museVanilla = function(_p)
    {
        var _tt = trueturn;
        var _ap = attackpattern;
        attackpattern = _p;
        event_user(0);
        trueturn = _tt;
        attackpattern = _ap;
    };

    mswapspecial = function(_from, _to)
    {
        for (var _i = 0; _i < attackcountmax; _i++)
        {
            if (list_attackspecial[_i] == _from)
            {
                list_attackspecial[_i] = _to;
            }
        }
    };

    mslashfx = function(_who)
    {
        if (_who < 0 || _who > 2)
        {
            return;
        }
        var _ss = (variable_instance_exists(id, ""mslashslot"") && mslashslot >= 0) ? mslashslot : myself;
        var _a = instance_create((global.monsterx[_ss] + random(6)) - 20, global.monstery[_ss] + random(6), obj_basicattack);
        if (global.char[_who] == 4)
        {
            _a.sprite_index = spr_attack_slap2;
            _a.image_speed = 0.5;
            _a.maxindex = 4;
        }
        else if (global.char[_who] == 1 && global.charweapon[1] == 26)
        {
            _a.sprite_index = spr_attack_shard;
            _a.image_speed = 0.334;
        }
    };
    mdodge = function(_who)
    {
        mslashslot = myself;
        if (_who >= 0)
        {
            mattacked = 1;
        }
        if (state == 13 && dodgetimer < 3)
        {
            mslashfx(_who);
            scr_tensionheal(60);
            return;
        }
        mslash = _who;
        state = 13;
        dodgetimer = 0;
        speed = 0;
        friction = 0;
        sprite_index = spr_gerson_teleport;
        image_index = 0;
        image_xscale = 3;
        image_yscale = 3;
        image_speed = 1;
        image_alpha = 1;
        x = xstart + (sin(movesiner / 5) * 10) + 40;
        y = ystart + 30;
        snd_stop(motor_swing_down);
        snd_play_pitch(motor_swing_down, 1.4);
    };

    madd = function(_spk, _ja, _en)
    {
        mspk[array_length(mspk)] = _spk;
        mtxt[array_length(mtxt)] = is_english() ? _en : _ja;
    };

    mbuild = function(_t)
    {
        mspk = [];
        mtxt = [];
        if (_t == 1)
        {
            madd(0, ""ほれ　どうした？&凍らせるんじゃ&なかったのか？/%"", ""Well? What're&ya waitin' for?&Weren't ya gonna&freeze me?/%"");
            madd(1, ""…言われなくても！/%"", ""...You don't&have to tell me!/%"");
        }
        if (_t == 2)
        {
            madd(0, ""ええ魔法じゃ。&ほんに　きれいな&氷じゃのう。/%"", ""Fine magic.&Real pretty ice,&that is./%"");
            madd(0, ""…無闇に　使うとは&もったいない。/%"", ""...Too good to&use so carelessly./%"");
            madd(1, ""…うるさい。/%"", ""...Be quiet./%"");
        }
        if (_t == 3)
        {
            madd(0, ""魔法は　だれに&教わった？/%"", ""Who taught ya&that magic?/%"");
            madd(1, ""この世界に&来てから　自由に&使えるように&なったの。/%"", ""Ever since I&came to this&world, I could&use it freely./%"");
            madd(0, ""ほう。　なら&その　使い道も&自分で&決められるのう。/%"", ""Oh? Then ya can&decide how to&use it yourself,&too./%"");
            madd(1, ""…/%"", "".../%"");
        }
        if (_t == 4)
        {
            madd(0, ""おじょうちゃん。&今　なんのために&戦っとる？/%"", ""Little missy.&What're ya&fightin' for?/%"");
            madd(1, ""…わたしを&守るため。/%"", ""...To protect&myself./%"");
            madd(1, ""…クリスが&そう　言ったから…/%"", ""...Because Kris&said so.../%"");
            madd(1, ""(…言ったっけ？)/%"", ""(...Did they?)/%"");
            madd(1, ""(ちがう…&今回クリスは&何も　言ってない…)/%"", ""(No... This time,&Kris didn't say&anything...)/%"");
        }
        if (_t == 5)
        {
            madd(0, ""おまえさんも&何か　言うたら&どうじゃ。/%"", ""How 'bout you&say somethin'&too?/%"");
            madd(2, ""…。/%"", ""..../%"");
            madd(1, ""(…やっぱり&答えて　くれない…)/%"", ""(...They still&won't answer...)/%"");
            madd(0, ""しでかしたことは&大きいが&今なら　まだ&引き返せるぞ。/%"", ""What ya done&ain't small, but&ya can still&turn back now./%"");
        }
        if (_t == 6)
        {
            madd(0, ""守られとる者は&そんな顔は&せんぞ。/%"", ""Someone who's&bein' protected&don't make a&face like that./%"");
            madd(1, ""…！/%"", ""...!/%"");
            madd(1, ""…わたし&どんな顔　してる？/%"", ""...What kind of&face am I making?/%"");
            madd(0, ""今にも&泣きそうな　顔じゃ。/%"", ""Like you're about&to cry./%"");
        }
        if (_t == 7)
        {
            madd(0, ""さっきの　あいつの&顔を　覚えとるか？/%"", ""Remember that&fella's face&from before?/%"");
            madd(1, ""…震えてた。/%"", ""...It was&trembling./%"");
            madd(0, ""凍らされた　連中も&みんな　あんな顔を&しとった　はずじゃ。/%"", ""The folks ya froze&must've all made&that same face./%"");
            madd(1, ""…やめて…/%"", ""...Stop.../%"");
        }
        if (_t == 8)
        {
            madd(1, ""わたし…&強く　ならないと&いけないの。/%"", ""I...&I have to get&stronger./%"");
            madd(0, ""強さとは&ただ　敵を&倒すことでは&ない。/%"", ""Strength ain't&just about&beatin' your&enemies./%"");
            madd(0, ""自分で　決めて&自分で&こうどうすることじゃ。/%"", ""It's decidin'&for yourself,&and actin' on it./%"");
            madd(0, ""…さっきの&おじょうちゃんの&ようにのう。/%"", ""...Like you did&back there,&little missy./%"");
            madd(1, ""…！/%"", ""...!/%"");
        }
        if (_t == 9)
        {
            madd(1, ""(わたしの　声…)/%"", ""(My voice...)/%"");
            madd(1, ""(ずっと&聞こえないふりを&してたのは…)/%"", ""(The one who kept&pretending not&to hear it...)/%"");
            madd(0, ""聞こえとるんじゃろう？&自分の　声が。/%"", ""Ya can hear it,&can't ya?&Your own voice./%"");
        }
        if (_t == 10)
        {
            madd(1, ""…もう　いや。/%"", ""...I can't&anymore./%"");
            madd(8, """", """");
            madd(1, ""わたし…&もう　誰かに従うのは&ごめんよ。/%"", ""I'm...&done doing what&I'm told./%"");
            madd(0, ""よう　言うた。/%"", ""Well said./%"");
            madd(9, """", """");
            madd(1, ""…クリス。&わたし　もう&あなたの　言いなりには&ならない。/%"", ""...Kris.&I won't do as&you say anymore./%"");
            madd(1, ""あなたを　止める。&わたしの　意思で。/%"", ""I'll stop you.&Of my own will./%"");
        }
        if (_t == 11)
        {
            madd(1, ""クリス…&もう　やめよう？/%"", ""Kris...&Can we stop&now?/%"");
        }
        if (_t == 12)
        {
            madd(1, ""…させない。/%"", ""...I won't&let you./%"");
            madd(1, ""クリスの&思い通りには！/%"", ""Not the way&you want it,&Kris!/%"");
        }
        if (_t == 13)
        {
            madd(1, ""怖くて&これは　私のため&という言葉を&信じるしか&なかった/%"", ""I was scared...&All I could do&was believe it&was for my own&good./%"");
        }
        if (_t == 14)
        {
            madd(1, ""でも　気付いたの/%"", ""But I realized&something./%"");
            madd(1, ""あやつり人形で&いるかぎり&わたしは&幸せになんて&なれない！/%"", ""I'll never be&happy!&Not if I'm&controlled&by you!/%"");
        }
        if (mshield == 0)
        {
            if (_t == 15)
            {
                madd(0, ""ほう…　今度は&そちらを&ねらうか。/%"", ""Oho... Goin' after&her now, are ya?/%"");
                madd(0, ""おじょうちゃん。&どうする？/%"", ""Missy.&What'll it be?/%"");
                madd(1, ""…逃げない。/%"", ""...I won't run./%"");
                madd(1, ""ここに　いる。&わたしが&決めたの。/%"", ""I'm staying.&I decided that&myself./%"");
            }
            if (_t == 16)
            {
                madd(0, ""ガッハッハ！/%"", ""Gah ha ha!/%"");
                madd(0, ""言うように&なったのう。/%"", ""Look at you,&talkin' tough!/%"");
                madd(0, ""…じゃが&気を　ぬくでないぞ。/%"", ""...But don't&let your guard&down./%"");
                madd(0, ""相手は&手加減を　知らん。/%"", ""This one doesn't&know how to&hold back./%"");
            }
            if (_t == 17)
            {
                madd(1, ""今度は　わたしが&クリスを　止める。/%"", ""This time,&I'll be the one&to stop Kris./%"");
            }
            if (_t == 18)
            {
                madd(1, ""…クリス？/%"", ""...Kris?/%"");
                madd(1, ""なんだか&様子が　へん…/%"", ""Something's...&off about you.../%"");
            }
            if (_t == 19)
            {
                madd(0, ""…妙じゃな。&何を待っている…？/%"", ""...Strange.&What're ya&waitin' for...?/%"");
            }
        }
    };

    mflavor = function(_t)
    {
        var _ja = ""＊ こうげきを　つづけろ。"";
        var _en = ""* Keep attacking."";
        if (_t == 2)
        {
            if (miceused)
            {
                _ja = ""＊ じいさんは　冷気を&　 ひょいと　かわした。"";
                _en = ""* The old man nimbly dodged&the cold air."";
            }
            else if (mattacked)
            {
                _ja = ""＊ じいさんは　こうげきを&　 ひょいと　かわした。"";
                _en = ""* The old man nimbly dodged&the attack."";
            }
            else
            {
                _ja = ""＊ こうげきを　しろ。&　 いつかは　当たるはずだ。"";
                _en = ""* Attack him.&Surely you'll land a hit someday."";
            }
        }
        if (_t == 3)
        {
            _ja = ""＊ ノエルは　ガーソンを&　 じっと　見ている。"";
            _en = ""* Noelle is staring at Gerson."";
        }
        if (_t == 4)
        {
            _ja = ""＊ ノエルの　冷気が&　 すこし　弱まった。"";
            _en = ""* Noelle's cold air weakened&a little."";
        }
        if (_t == 5)
        {
            _ja = ""＊ じいさんは　あなたの方を&　 見た。"";
            _en = ""* The old man looked at you."";
        }
        if (_t == 6)
        {
            _ja = ""＊ 冷気が　床を&　 つたっていく。"";
            _en = ""* Cold air creeps across&the floor."";
        }
        if (_t == 7)
        {
            _ja = ""＊ ノエルの　手が&　 ふるえている。"";
            _en = ""* Noelle's hands are shaking."";
        }
        if (_t == 8)
        {
            _ja = ""＊ ノエルは　魔法を&　 ためらっている。"";
            _en = ""* Noelle hesitates to use&her magic."";
        }
        if (_t == 9)
        {
            _ja = ""＊ ノエルは　戦いたく&　 なさそうだ。"";
            _en = ""* Noelle doesn't seem to want&to fight."";
        }
        if (_t == 10)
        {
            _ja = ""＊ ノエルは　もう&　 魔法を　唱えたくない。"";
            _en = ""* Noelle no longer wants to&cast her magic."";
        }
        if (_t == 11)
        {
            _ja = ""＊ ノエルが　じいさんの&　 となりに　立っている。"";
            _en = ""* Noelle stands beside&the old man."";
        }
        if (_t == 13)
        {
            _ja = ""＊ じいさんの　うごきは　さらに&　 かそく　した。"";
            _en = ""* The old man's movements&grew even faster."";
        }
        if (_t >= 15)
        {
            if (mshield == 0)
            {
                _ja = ""＊ \\cRノエルを　ねらえ。\\cW"";
                _en = ""* \\cRAim for Noelle.\\cW"";
            }
            if (mshield == 0)
            {
                if (_t == 16)
                {
                    _ja = ""＊ じいさんは　ノエルを&　 かばっている。"";
                    _en = ""* The old man is shielding&Noelle."";
                }
                if (_t == 17)
                {
                    _ja = ""＊ ノエルは　逃げようと　しない。"";
                    _en = ""* Noelle won't run away."";
                }
                if (_t == 18)
                {
                    _ja = ""＊ クリスは　じいさんの&　 うごきを　見ている。"";
                    _en = ""* Kris is watching the old man's&movements."";
                }
                if (_t == 19)
                {
                    _ja = ""＊ クリスは　何かを　つかんだ。"";
                    _en = ""* Kris grasped something."";
                }
            }
            else if (mpost <= 1)
            {
                _ja = ""＊ じいさんの　うごきは　さらに&　 かそく　した。"";
                _en = ""* The old man's movements&grew even faster."";
            }
            else
            {
                _ja = ""＊ \\cRクリスは　せきをした。\\cW"";
                _en = ""* \\cRKris coughed.\\cW"";
            }
        }
        global.battlemsg[0] = is_english() ? _en : _ja;
    };

    mshow = function()
    {
        var _s = mspk[mline];
        mtalktimer = 0;
        if (_s == 8)
        {
            mwait = 1;
            mice = 1;
            micet = 0;
            return;
        }
        if (_s == 9)
        {
            mwait = 1;
            mdefect = 1;
            mdeftimer = 0;
            return;
        }
        msgset(0, mtxt[mline]);
        if (_s == 0)
        {
            global.typer = 86;
            if (i_ex(mgmark))
            {
                scr_enemyblcon(mgmark.x - 10, mgmark.y + 20, 10);
            }
            else
            {
                scr_enemyblcon(x - 10, global.monstery[myself], 10);
            }
        }
        if (_s == 1)
        {
            global.typer = 76;
            if (mdefect >= 2 && i_ex(nenemy))
            {
                scr_enemyblcon(nenemy.x - 56, nenemy.y + 30, 10);
            }
            else
            {
                scr_heroblcon(""noelle"");
            }
        }
        if (_s == 2)
        {
            global.typer = 50;
            scr_heroblcon(""kris"");
        }
    };
}
");

