        c_wait(10);
        c_customfunc(function()
        {
            with (obj_ch4_DCA01)
            {
                prophecy.destroy = 1;
                kr_actor.sprite_index = spr_kris_fall_dw_hurt;
                kr_actor.image_speed = 0;
