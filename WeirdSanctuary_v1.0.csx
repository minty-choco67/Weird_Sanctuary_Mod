importGroup.QueuePrepend(Step("obj_dw_church_intro_guei"), @"
if (global.flag[2450] == 1 && variable_instance_exists(id, ""mcon"") && mcon >= 0)
{
    if (cutscene == 0 && scr_trigcheck(""line1""))
    {
        global.plot = 126;
        scr_speaker(""noelle"");
        if (is_english())
        {
            msgset(0, ""\\Ek* (They said we'd pick up where we left off yesterday...)/"");
            msgnext(""\\Ed* (It really is..^1. like a dream here...)/%"");
        }
        else
        {
            msgset(0, ""\\Ek＊ (昨日の　続きを　すると\n　 言われて　来たけど…)/"");
            msgnext(""\\Ed＊ (本当に\n　 夢のような　場所…)/%"");
        }
        cutscene = 1;
        scr_walkntalk_start(1);
    }
    if (cutscene == 2 && scr_trigcheck(""line2""))
    {
        scr_speaker(""noelle"");
        if (is_english())
        {
            msgset(0, ""\\Ee* (To protect me..^1. this is necessary too^1, right...?)/"");
            msgnext(""\\Ee* (.....)/"");
            msgnext(""\\Ek* (You can see this too^1, but you won't answer me...)/%"");
        }
        else
        {
            msgset(0, ""\\Ee＊ (わたしを　まもるため\n　 これも　ひつような\n　 ことなんだよね？)/"");
            msgnext(""\\Ee＊ (…)/"");
            msgnext(""\\Ek＊ (これも　見えてる　くせに\n　 答えて　くれないんだ…)/%"");
        }
        scr_walkntalk_start(1);
        global.plot = 127;
        cutscene = 3;
    }
    if (mcon == 0 && global.fighting == 0 && i_ex(obj_mainchara) && global.flag[encounterflag] != 6)
    {
        global.flag[2454] = obj_mainchara.x;
        global.flag[2455] = obj_mainchara.y;
    }
    if (mcon == 0 && global.fighting == 0 && global.flag[encounterflag] == 6)
    {
        with (obj_encounter_guei_alt)
        {
            if (chaser != 0 && instance_exists(chaser))
            {
                with (chaser)
                {
                    instance_destroy();
                }
            }
            instance_destroy();
        }
        mcon = 2;
    }
    if (mcon == 2)
    {
        mcon = 3;
        mod_statue = instance_create(global.flag[2454] + 19 - 71, global.flag[2455] - 110, obj_frozennpc);
        with (mod_statue)
        {
            sprite_index = spr_guei_hurt;
            image_index = 0;
