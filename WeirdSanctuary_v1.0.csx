                kr_actor.image_xscale = 2;
                kr_actor.x = (camerax() + 320) - 68;
                fallsequence.delta = 0.05;
                wind_effect.windspeed = 2.2;
                with (kr_actor)
                {
                    scr_lerpvar(""y"", y, y + 5, 10, 2, ""out"");
                }
            }
            snd_play(snd_hurt1);
        });
        c_wait(10);
        c_customfunc(function()
        {
            with (obj_ch4_DCA01)
            {
                fallsequence.delta = 1;
                fallsequence.con = 3;
                with (wind_effect)
                {
