    else
    {
        c_msgset(0, ""\\E3＊ い…言われた　通り\n　 教会に　来たよ…/"");
        c_msgnext(""\\EX＊ えっと…\n　 じゃあ　行こっか…/%"");
    }
    c_talk_wait();
    c_wait(10);
    c_sel(kr);
