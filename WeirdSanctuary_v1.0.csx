};
mev_freeze_copy = function(_spr, _ix, _xx, _yy, _xs, _ys, _dep)
{
    with (instance_create(_xx, _yy, obj_frozennpc))
    {
        sprite_index = _spr;
        image_index = _ix;
        image_xscale = _xs;
        image_yscale = _ys;
        fresh = 1;
        skipsolid = 1;
        timer = 1;
        skipsound = 1;
        depth = _dep;
        modkeep = 1;
    }
};
mev_frozen_room = function()
{
    var _ov = instance_create(0, 0, obj_marker);
    with (_ov)
    {
        sprite_index = spr_pxwhite;
        image_xscale = room_width;
        image_yscale = room_height;
        image_blend = make_color_rgb(150, 215, 255);
        image_alpha = 0.3;
        depth = 999000;
        modfrozen = 1;
