        }
        c_talk_wait();
        c_sel(ra);
        c_walkdirect(310, 299, 40);
        c_delayfacing(41, ""l"");
        c_sel(kr);
        c_delayfacing(41, ""r"");
        c_wait(60);
        c_sel(ra);
        c_sprite(spr_ralsei_head_down_smile_left);
        c_speaker(""ralsei"");
        if (is_english())
        {
            c_msgset(0, ""\\EQ* Thank goodness..^1. you're safe./%"");
        }
        else
