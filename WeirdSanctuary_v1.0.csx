importGroup.QueueAppend(Ev("obj_dw_church_intropiano", EventType.Create), @"
modcon = -1;
customcon = 0;
if (global.flag[2450] == 1 && global.flag[2452] == 0)
{
    modcon = 0;
}
");

importGroup.QueueAppend(Step("obj_dw_church_intropiano"), @"
if (global.flag[2450] == 1 && global.flag[2452] == 1)
{
    if (variable_instance_exists(id, ""slight""))
    {
        with (slight)
        {
            instance_destroy();
        }
    }
}
if (modcon == 0 && global.interact == 0 && i_ex(obj_mainchara) && !d_ex())
{
    if (obj_mainchara.x >= 1030 && obj_mainchara.x <= 1090 && obj_mainchara.y > 256)
    {
        modcon = 1;
        global.interact = 1;
    }
}
if (modcon == 1)
{
    modcon = 2;
    customcon = 0;
    global.mod_choice = -1;
    cutscene_master = scr_cutscene_make();
    scr_maincharacters_actors();
    c_wait(1);
    c_msc(9714);
    c_talk_wait();
    c_waitcustom();
}
if (modcon == 2 && customcon == 1 && !d_ex() && global.mod_choice >= 0)
{
    customcon = 0;
    c_waitcustom_end();
    if (global.mod_choice == 0)
    {
        modcon = 10;
        c_actortokris();
        c_actortocaterpillar();
        c_terminatekillactors();
        exit;
    }
    modcon = 3;
    global.mod_choice = -1;
    mod_vw = view_wport[0];
    mod_vh = view_hport[0];
    mod_camx = clamp(1040 - floor((mod_vw / 2) - (obj_mainchara.initwd / 2)), 0, room_width - mod_vw);
    mod_camy = clamp(300 - floor((mod_vh / 2) - (obj_mainchara.initht / 2)), 0, room_height - mod_vh);
    c_pannable(1);
    c_pan_wait(mod_camx, room_height - mod_vh, 24);
    c_sel(kr);
    c_walkdirect(1040, 300, 12);
    c_delayfacing(13, ""u"");
    c_sel(su);
    c_walkdirect_speed_wait(1060, 200, 6);
    c_facing(""d"");
    c_wait(10);
    c_speaker(""susie"");
    if (is_english())
    {
        c_msgset(0, ""\\E0* Huh? What's up^1, Kris?/"");
        c_msgnext(""\\E2* ..^1. Wait^1, there's a pool of JUICE down there!?/%"");
    }
    else
    {
        c_msgset(0, ""\\E0＊ あ？\n　 どうした^1　クリス？/"");
        c_msgnext(""\\E2＊ …下に^1　ジュースの\n　 いけが　あるって！？/%"");
    }
    c_talk_wait();
    c_sel(su);
    c_autowalk(0);
    c_sprite(spr_susie_run_down);
    c_imagespeed(0.4);
    c_addxy(0, -8);
    c_walkdirect_speed_wait(1060, 412, 10);
    c_imagespeed(0);
    c_addxy(0, 8);
    c_autowalk(1);
    c_facing(""d"");
    c_sel(kr);
    c_facing(""d"");
    c_sel(su);
    c_facing(""d"");
    c_wait(15);
    c_addxy(0, 6);
    c_wait(40);
    c_speaker(""susie"");
    if (is_english())
    {
        c_msgset(0, ""\\E1* ..^1. Where? I can't see a thing./"");
        c_msgnext(""\\E1* Kris^1, it's way too dark^1, I don't.../%"");
    }
    else
    {
        c_msgset(0, ""\\E1＊ …どこだよ？\n　 なんにも　見えねえぞ。/"");
        c_msgnext(""\\E1＊ クリス^1　暗すぎて\n　 わかんねえって…/%"");
    }
    c_talk_wait();
    c_wait(10);
    c_msc(9710);
    c_talk_wait();
    c_waitcustom();
}
if (modcon == 3 && customcon == 1 && !d_ex() && global.mod_choice >= 0)
{
    customcon = 0;
    c_waitcustom_end();
    if (global.mod_choice == 0)
    {
        modcon = 10;
        c_wait(20);
        c_sel(su);
        c_addxy(0, -6);
        c_facing(""u"");
        c_wait(10);
        c_speaker(""susie"");
        if (is_english())
        {
            c_msgset(0, ""\\E1* Huh? Guess I was seeing things?/"");
            c_msgnext(""\\E0* ..^1. Tch. I'm going on ahead./%"");
        }
        else
        {
            c_msgset(0, ""\\E1＊ …え？　やっぱり\n　 見まちがいか？/"");
            c_msgnext(""\\E0＊ …たくっ。\n　 先　行くぞ。/%"");
        }
        c_talk_wait();
        c_sel(su);
        c_walkdirect_speed_wait(1060, 230, 6);
        c_pan(mod_camx, mod_camy, 20);
        c_wait(20);
        c_actortokris();
        c_actortocaterpillar();
        c_pannable(0);
        c_terminatekillactors();
    }
    else
    {
        modcon = 20;
        c_wait(20);
        c_customfunc(function()
        {
            global.mod_blk = scr_dark_marker(camerax() - 20, cameray() - 20, spr_pixel_white);
            with (global.mod_blk)
            {
                image_xscale = 999;
                image_yscale = 999;
                image_blend = c_black;
                image_alpha = 1;
                depth = 100;
            }
            mus_volume(global.currentsong[1], 0, 10);
        });
        c_wait(40);
        c_customfunc(function()
        {
            snd_play(snd_laz_c);
            var _s = scr_dark_marker(1082, 465, spr_attack_cut1);
            with (_s)
            {
                depth = 80;
                image_speed = 0.5;
                scr_doom(id, 12);
            }
        });
        c_wait(8);
        c_soundplay(snd_damage);
        c_sel(su);
        c_visible(0);
        c_customfunc(function()
        {
            global.mod_fallspr = scr_dark_marker(1060, 420, spr_susie_dw_fall_d);
            with (global.mod_fallspr)
            {
                depth = 90;
                image_speed = 0;
            }
        });
        c_wait(10);
        c_speaker(""susie"");
        if (is_english())
        {
            c_msgset(0, ""\\Ec* Gah...!/%"");
        }
        else
        {
            c_msgset(0, ""\\Ec＊ ガッ…！/%"");
        }
        c_talk_wait();
        c_customfunc(function()
        {
            with (global.mod_fallspr)
            {
                image_speed = 0.25;
                vspeed = 1;
                gravity = 0.4;
                scr_doom(id, 60);
            }
        });
        c_wait(100);
        c_customfunc(function()
        {
            with (global.mod_blk)
            {
                scr_lerpvar(""image_alpha"", 1, 0, 45);
                scr_doom(id, 46);
            }
        });
        c_wait(60);
        c_sel(kr);
        c_facing(""d"");
        c_wait(30);
        c_pan(mod_camx, mod_camy, 30);
        c_wait(30);
        c_customfunc(function()
        {
            global.facing = 0;
            with (obj_mainchara)
            {
                sprite_index = dsprite;
                image_index = 0;
            }
        });
        c_actortokris();
        c_pannable(0);
        c_terminatekillactors();
    }
}
if (modcon == 10 && !i_ex(obj_cutscene_master))
{
    modcon = 99;
    global.flag[2450] = 0;
    global.facing = 0;
    global.interact = 0;
}
if (modcon == 20 && !i_ex(obj_cutscene_master))
{
    modcon = 99;
    global.flag[2452] = 1;
    scr_setparty(0, 0, 0);
    if (variable_instance_exists(id, ""slight""))
    {
        with (slight)
        {
            instance_destroy();
        }
    }
    mus_volume(global.currentsong[1], 0.7, 60);
    global.facing = 0;
    global.interact = 0;
}
");

importGroup.QueuePrepend(Ev("obj_ch4_DCA01", EventType.Create), @"
if (global.flag[2450] == 1 && global.plot >= 105 && global.plot < 110)
{
    mcon = 0;
    customcon = 0;
    con = -1;
    scr_setparty(0, 0, 0);
    bullet_area = instance_find(obj_overworld_bulletarea, 0);
    with (bullet_area)
    {
        keepHidden = 1;
    }
    broken_stairs_marker = instance_create(142, 3964, obj_dw_church_stairs_broken);
    broken_stairs_marker.depth = 999990;
    broken_stairs_marker.visible = 0;
    wind_effect = instance_create(0, 0, obj_church_wind_effect);
    wind_effect.con = 0;
    blackall = scr_dark_marker(-10, -10, spr_pixel_white);
    blackall.image_xscale = 999;
    blackall.image_yscale = 9999;
    blackall.depth = 100;
    blackall.image_blend = c_black;
    blackall.image_alpha = 0;
    fallsequence = -4;
    mod_hole = -4;
    prophecy = -4;
    mod_wind_snd = -4;
    var _blk = instance_create(580, 4040, obj_solidblocksized);
    with (_blk)
    {
        image_xscale = 1;
        image_yscale = 7;
    }
    for (var _i = 0; _i < 3; _i++)
    {
        var _cone = scr_dark_marker(584, 4070 + (_i * 60), spr_coaster_barricade);
        with (_cone)
        {
            scr_depth();
        }
    }
    with (obj_doorAny)
    {
        if (x > 600 && y > 4000)
        {
            instance_destroy();
        }
    }
    exit;
}
");

importGroup.QueuePrepend(Step("obj_ch4_DCA01"), @"
if (global.flag[2450] == 1 && variable_instance_exists(id, ""mcon""))
{
    if (mcon == 0 && global.interact == 0 && i_ex(obj_mainchara))
    {
        if (obj_mainchara.x >= 240 && obj_mainchara.y < 3700)
        {
            mcon = 1;
            global.interact = 1;
        }
    }
    if (mcon == 1)
    {
        mcon = 2;
        cutscene_master = scr_cutscene_make();
        scr_maincharacters_actors();
        c_sel(kr);
        c_halt();
        c_facing(""u"");
