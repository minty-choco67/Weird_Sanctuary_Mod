                if (sprite_index == spr_roaringknight_arms_cross)
                {
                    instance_destroy();
                }
            }
            with (mkrl)
            {
                instance_destroy();
            }
            if (i_ex(_krk))
            {
                _krk.visible = 1;
            }
        }
        if (mfintimer == 440)
        {
            mfin = 9;
            global.modfreezebt = 0;
            global.modgerturn = 0;
            with (obj_darkener)
            {
                instance_destroy();
            }
            with (obj_gerson_darken)
            {
                instance_destroy();
            }
            with (mblack)
            {
                instance_destroy();
            }
            global.heromakex[1] = camerax() + 900;
            with (obj_caterpillarchara)
            {
                if (name == ""noelle"")
                {
                    setxy(camerax() + 900, 900);
                    scr_caterpillar_interpolate();
                }
            }
            scr_wincombat();
        }
    }
    if (mfin >= 2)
    {
        exit;
    }
}
");

