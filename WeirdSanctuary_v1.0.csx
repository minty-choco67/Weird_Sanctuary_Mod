        {
            image_speed = 1/3;
            scr_depth();
        }
        mod_hair = scr_dark_marker(mod_land.x + 36, mod_land.y + 10, spr_gerson_hair);
        with (mod_hair)
        {
            image_speed = 0.2;
            depth = other.mod_land.depth - 1;
        }
    }
    if (mcon == 21)
    {
        global.interact = 1;
        mquick++;
        if (mquick == 30)
        {
            snd_play_pitch(motor_swing_down, 1.4);
        }
        if (mquick >= 40)
        {
            mcon = 1;
        }
    }
    if (mcon == 0 && global.interact == 0 && i_ex(obj_mainchara) && !d_ex())
    {
        mcon = 1;
        global.interact = 1;
        cutscene_master = scr_cutscene_make();
        scr_maincharacters_actors();
        c_sel(kr);
        c_walkdirect(330, 870, 30);
        c_sel(no);
        c_walkdirect(440, 866, 40);
        c_wait(41);
        c_sel(kr);
        c_facing(""r"");
        c_sel(no);
        c_facing(""r"");
        c_wait(15);
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* Now then..^1. Let's have that talk^1, like I promised./%"");
        }
        else
        {
            c_msgset(0, ""＊ さて…\n　 約束どおり　話を\n　 しようかの。/%"");
        }
        c_talk_wait();
        c_speaker(""noelle"");
        if (is_english())
        {
            c_msgset(0, ""\\EV* ..^1. So where did that enemy run off to?/%"");
        }
        else
        {
            c_msgset(0, ""\\EV＊ …それで　さっきの　敵は\n　 どこに　逃げたんです？/%"");
        }
        c_talk_wait();
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* That can wait till after our talk./"");
            c_msgnext(""* Little missy^1, ya held back real well earlier./%"");
        }
        else
        {
            c_msgset(0, ""＊ それは　話の　あとじゃ。/"");
            c_msgnext(""＊ おじょうちゃん\n　 さっきは　よう\n　 こらえたのう。/%"");
        }
        c_talk_wait();
        c_speaker(""noelle"");
        if (is_english())
        {
            c_msgset(0, ""\\EW* ..^1. Like I said^1, it's not like I let it go on purpose./%"");
        }
        else
        {
            c_msgset(0, ""\\EW＊ …だから　見逃したわけじゃ\n　 ありません。/%"");
        }
        c_talk_wait();
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* Seems ya haven't found your answer yet./"");
            c_msgnext(""* That's fine. An answer ain't somethin' to rush./%"");
        }
        else
        {
            c_msgset(0, ""＊ 答えは　まだ\n　 出とらんようじゃな。/"");
            c_msgnext(""＊ それで　いい。\n　 答えは　急ぐものでは　ない。/%"");
        }
        c_talk_wait();
        c_wait(30);
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* But you're a different story./"");
            c_msgnext(""* These eyes of mine ain't so easy to fool./"");
            c_msgnext(""* She's the one doin' the freezin'^1, but.../"");
            c_msgnext(""* You're the one who made her believe it was right^1, ain't ya^1, red one?/"");
            c_msgnext(""* Never dirtyin' your own hands^1, never answerin' when asked.../"");
            c_msgnext(""* Even when that girl's strugglin'^1, you just stand there watchin'./"");
            c_msgnext(""* ..^1. You might be fine with that^1, but I ain't./"");
            c_msgnext(""* Folks frozen solid.../"");
            c_msgnext(""* That little missy used like a tool.../"");
            c_msgnext(""* I ain't so old I can look at that and pretend I didn't see./%"");
        }
        else
        {
            c_msgset(0, ""＊ じゃが　おまえさんは\n　 別じゃ。/"");
            c_msgnext(""＊ ワシの　目は\n　 ごまかせんぞ。/"");
            c_msgnext(""＊ 凍らせとるのは\n　 おじょうちゃん　じゃが/"");
            c_msgnext(""＊ それが　正しいと\n　 思いこませたのは\n　 赤いおまえさんじゃろう。/"");
            c_msgnext(""＊ 自分の　手は　汚さず\n　 聞かれても　答えず…/"");
            c_msgnext(""＊ あの子が　迷っとる　時も\n　 だまって　見とるだけじゃ。/"");
            c_msgnext(""＊ …おまえさんが　平気でも\n　 ワシは　ちがう。/"");
            c_msgnext(""＊ 氷づけの　連中を/"");
            c_msgnext(""＊ おじょうちゃんを\n　 道具の様に　扱うのを/"");
            c_msgnext(""＊ 見て見ないふりが　できるほど\n　 老いぼれては　おらん。/%"");
        }
        c_talk_wait();
        c_speaker(""noelle"");
        if (is_english())
        {
            c_msgset(0, ""\\EW* ..^1. Don't say such awful things to Kris!/"");
            c_msgnext(""\\Ee* (I...)/"");
            c_msgnext(""\\Em* ..^1. If you get in my way^1, I'll freeze you too./%"");
        }
        else
        {
            c_msgset(0, ""\\EW＊ …クリスに\n　 ひどいこと　言わないで！/"");
            c_msgnext(""\\Ee＊ (わたしは…)/"");
            c_msgnext(""\\Em＊ …じゃまを　するなら\n　 あなたも　氷づけに\n　 するから。/%"");
        }
        c_talk_wait();
        c_var_instance(gerson_npc, ""current_state"", 5);
        c_snd_play(snd_gerlaugh);
        c_speaker(""gerson"");
        if (is_english())
        {
            c_msgset(0, ""* Gah ha ha! Ya sure got spirit!/"");
            c_msgnext(""* Very well./%"");
        }
        else
        {
            c_msgset(0, ""＊ ガッハッハ！\n　 威勢が　いいのう！/"");
            c_msgnext(""＊ よかろう。/%"");
        }
        c_talk_wait();
        c_var_instance(gerson_npc, ""current_state"", 0);
        c_var_instance(gerson_npc, ""current_sprite_index"", spr_gerson_outfit_walk_cane);
        c_wait(20);
        c_customfunc(function()
        {
            with (obj_dw_gerson_study)
