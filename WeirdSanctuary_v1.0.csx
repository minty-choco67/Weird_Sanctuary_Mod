        c_autowalk(0);
        c_sprite(spr_ralsei_running_up);
        c_imagespeed(0.4);
        c_walkdirect(300, 130, 20);
        c_delaycmd4(17, ""var"", id, ""ralsei_hide"", true);
        c_delaycmd(30, ""visible"", 0);
        c_sel(kr);
        c_delayfacing(4, ""u"");
        c_wait(60);
        c_wait_talk();
        c_sel(kr);
        c_facing(""d"");
        c_wait(2);
        c_customfunc(function()
        {
            global.facing = 0;
            with (obj_mainchara)
            {
